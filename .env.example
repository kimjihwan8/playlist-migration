# Spotify Developer Dashboard 에서 만든 앱의 Client ID
# client_secret 은 쓰지 않는다 — PKCE 라서 서버에 보관할 비밀이 없다.
SPOTIFY_CLIENT_ID=

# 앱이 서비스되는 주소. Dashboard 의 Redirect URI 는 여기에 /api/auth/callback 을 붙인 값이어야 한다.
#   로컬: http://127.0.0.1:5174  → http://127.0.0.1:5174/api/auth/callback
APP_URL=http://127.0.0.1:5174

# 세션 쿠키 암호화 키. 아무 긴 랜덤 문자열.
#   openssl rand -base64 32
SESSION_SECRET=
